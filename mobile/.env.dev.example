# if using android studio
EXPO_PUBLIC_KEYCLOAK_URL=http://10.0.2.2
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2
# if using expo go
EXPO_PUBLIC_KEYCLOAK_URL=http://YourIpAddres
EXPO_PUBLIC_BACKEND_URL=http://YourIpAddres
# YourIpAddres is for example 192.168.1.20 (YOUR PC MIGHT HAVE DIFFRENT ONE)
# BACKEND_URL uses the same host as KEYCLOAK_URL -- both go through nginx (port 80),
# the backend itself has no port exposed directly. Calls go to /api/...